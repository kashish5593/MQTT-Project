pipeline {
    agent any

    environment {
        APP_NAME         = 'mqtt-telemetry-dashboard'
        REGISTRY_HOST    = 'docker.io'                    // Change to your registry host if needed
        IMAGE_NAME       = "my-docker-user/${APP_NAME}"   // Replace with your repository name
        IMAGE_TAG        = "${BUILD_NUMBER}"
        REGISTRY_CRED_ID = 'docker-registry-credentials' // Jenkins Credentials ID (Username/Password)
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scms
            }
        }

        stage('Code Quality & Lint') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    python -m venv .venv
                    . .venv/bin/activate
                    pip install --no-cache-dir flake8
                    # Basic syntax and semantic error check
                    flake8 app.py --count --select=E9,F63,F7,F82 --show-source --statistics
                    # PEP8 guidelines check (warnings treated gently)
                    flake8 app.py --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics
                '''
            }
        }

        stage('Unit Tests') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    python -m venv .venv
                    . .venv/bin/activate
                    pip install --no-cache-dir -r requirements.txt
                    # Validate imports and compilation
                    python -m py_compile app.py
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dockerImage = docker.build("${IMAGE_NAME}:${IMAGE_TAG}", "-f Dockerfile .")
                }
            }
        }

        stage('Container Smoke Test') {
            steps {
                sh """
                    # Spin up container detached
                    CID=\$(docker run -d -p 8050:8050 ${IMAGE_NAME}:${IMAGE_TAG})
                    
                    # Allow server to initialize
                    sleep 5
                    
                    # Verify port accessibility / HTTP responsiveness
                    docker run --rm --network host curlimages/curl:latest \\
                        --fail --retry 3 --retry-delay 2 http://localhost:8050/ || {
                            docker logs \$CID
                            docker stop \$CID && docker rm \$CID
                            exit 1
                        }

                    # Cleanup container
                    docker stop \$CID && docker rm \$CID
                """
            }
        }

        stage('Push Image') {
            when {
                branch 'main'
            }
            steps {
                script {
                    docker.withRegistry("https://${REGISTRY_HOST}", REGISTRY_CRED_ID) {
                        dockerImage.push("${IMAGE_TAG}")
                        dockerImage.push('latest')
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
        success {
            echo "Pipeline succeeded for ${APP_NAME} (Build #${BUILD_NUMBER})."
        }
        failure {
            echo "Pipeline failed! Please inspect logs."
        }
    }
}